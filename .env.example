# Copy this file to .env. Only OPENAI_API_KEY needs a real value to run
# locally; the rest matches docker-compose.yml.

DATABASE_URL=postgresql+asyncpg://askdocumind:secret@localhost:5432/askdocumind_db

# Signs the anonymous session cookie. At least 32 characters.
ANONYMOUS_TOKEN_SECRET=replace-me-with-a-random-string-of-32-chars-or-more

# MinIO from docker-compose.yml. Create the bucket before uploading.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=secretpassword
S3_BUCKET_NAME=askdocumind-uploads

OPENAI_API_KEY=sk-your-key

# Required at startup. Any value works if you don't use web search.
BRAVE_API_KEY=unused
